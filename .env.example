# Aikya AI local-development configuration template.
# Copy to .env. Never use these recognizable development values in production.

# Application
AIKYA_ENV=development
AIKYA_LOG_LEVEL=INFO
AIKYA_PUBLIC_URL=http://localhost:3000
AIKYA_API_URL=http://localhost:8000
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_API_BASE=
NUXT_API_PROXY_TARGET=http://backend:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Production application images (must be immutable tags/digests outside local foundation)
AIKYA_FRONTEND_IMAGE=replace-with-approved-frontend-image
AIKYA_BACKEND_IMAGE=replace-with-approved-backend-image

# PostgreSQL
POSTGRES_DB=aikya-ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:1234@postgres:5432/aikya-ai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis and Celery
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# S3-compatible storage / MinIO development emulator
STORAGE_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_QUARANTINE=aikya-quarantine
STORAGE_BUCKET_DOCUMENTS=aikya-documents
STORAGE_BUCKET_OUTPUTS=aikya-outputs
STORAGE_ACCESS_KEY=aikya-local-access
STORAGE_SECRET_KEY=development-only-storage-secret
STORAGE_USE_PATH_STYLE=true
MINIO_ROOT_USER=aikya-local-access
MINIO_ROOT_PASSWORD=development-only-storage-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SIGNED_URL_TTL_SECONDS=300

# Authentication - generate unique values locally; use a secret manager in production
AUTH_SECRET_KEY=development-only-auth-secret-change-before-production-32bytes
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
AUTH_OAUTH_STATE_TTL_SECONDS=600
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Aikya AI
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL_SECONDS=300

# Translation provider - required for translation workflows
TRANSLATION_DEFAULT_PROVIDER=libretranslate
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
MICROSOFT_TRANSLATOR_API_KEY=
MICROSOFT_TRANSLATOR_REGION=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# AI providers - optional and never invoked implicitly
AI_DEFAULT_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# OCR and speech providers
OCR_DEFAULT_ENGINE=paddleocr
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
ELEVENLABS_API_KEY=

# Payment providers - use sandbox/test keys only in development
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email and notifications
EMAIL_PROVIDER=
EMAIL_FROM=no-reply@example.invalid
EMAIL_API_KEY=

# Limits and retention
MAX_UPLOAD_BYTES=52428800
MAX_DOCUMENT_PAGES=100
TEMPORARY_FILE_RETENTION_HOURS=24
SIGNED_DOWNLOAD_TTL_SECONDS=300
DEFAULT_JOB_CONCURRENCY=1
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=900
TRANSLATION_RATE_LIMIT=30
UPLOAD_RATE_LIMIT=10
WORKLOAD_RATE_WINDOW_SECONDS=60

# Security and scanning
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_COUNT=0

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
METRICS_ENABLED=true
LOG_DOCUMENT_CONTENT=false

# Production reference ports
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
