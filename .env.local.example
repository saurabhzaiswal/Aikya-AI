# Aikya AI native Windows development template.
# Copy to .env.local. The real file is ignored by Git.
# These recognizable values are local-only and must never be used in production.

# Native application processes
AIKYA_ENV=development
AIKYA_LOG_LEVEL=DEBUG
AIKYA_PUBLIC_URL=http://localhost:3000
AIKYA_API_URL=http://127.0.0.1:8000
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_API_BASE=
NUXT_API_PROXY_TARGET=http://127.0.0.1:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Optional WSL distribution override. Empty means the user's default distribution.
AIKYA_WSL_DISTRIBUTION=

# PostgreSQL 17 running on Windows
POSTGRES_DB=aikya-ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:1234@localhost:5432/aikya-ai

# Redis running in WSL and forwarded to Windows localhost
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# Repository-pinned MinIO Windows binary
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET_QUARANTINE=aikya-quarantine
STORAGE_BUCKET_DOCUMENTS=aikya-documents
STORAGE_BUCKET_OUTPUTS=aikya-outputs
STORAGE_ACCESS_KEY=aikya-local-access
STORAGE_SECRET_KEY=development-only-storage-secret
STORAGE_USE_PATH_STYLE=true
MINIO_ROOT_USER=aikya-local-access
MINIO_ROOT_PASSWORD=development-only-storage-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SIGNED_URL_TTL_SECONDS=300
SIGNED_DOWNLOAD_TTL_SECONDS=300

# Authentication
AUTH_SECRET_KEY=development-only-auth-secret-change-before-production-32bytes
AUTH_ISSUER=aikya-ai
AUTH_AUDIENCE=aikya-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
AUTH_OAUTH_STATE_TTL_SECONDS=600
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Aikya AI
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL_SECONDS=300

# Phase 1 limits
MAX_UPLOAD_BYTES=52428800
MAX_DOCUMENT_PAGES=100
MAX_TEXT_TRANSLATION_CHARACTERS=10000
TEMPORARY_FILE_RETENTION_HOURS=24
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=900
TRANSLATION_RATE_LIMIT=30
UPLOAD_RATE_LIMIT=10
WORKLOAD_RATE_WINDOW_SECONDS=60

# LibreTranslate-compatible provider. Leave empty until a trusted provider is selected.
TRANSLATION_DEFAULT_PROVIDER=libretranslate
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
TRANSLATION_REQUEST_TIMEOUT_SECONDS=30

# ClamAV daemon running in WSL and forwarded to Windows localhost
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30
CLAMAV_CHUNK_BYTES=1048576
