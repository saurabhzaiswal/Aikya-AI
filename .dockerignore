# The repository root is not an application build context. These rules keep an
# accidental `docker build .` bounded and prevent private/local data transfer.
.git
.github
.agents
.codex
.idea
.vscode
docs
tmp
logs
.uv-cache
.uv-python

.env
.env.*
!.env.example
!.env.*.example
*.local
*.log
*.pem
*.key

**/node_modules
**/.npm-cache
**/.nuxt
**/.output
**/.data
**/dist
**/.cache
**/.vite
**/coverage

**/.venv
**/.venv*
**/venv
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.uv-cache

