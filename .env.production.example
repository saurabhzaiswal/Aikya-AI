# Values such as URLs, credentials, keys, and image digests must be injected by the deployment platform.
AIKYA_ENV=production
AIKYA_LOG_LEVEL=INFO
NUXT_PUBLIC_SITE_URL=https://aikya.example
NUXT_PUBLIC_API_BASE=
AUTH_COOKIE_SECURE=true
AIKYA_FRONTEND_IMAGE=replace-with-approved-image-digest
AIKYA_BACKEND_IMAGE=replace-with-approved-image-digest
